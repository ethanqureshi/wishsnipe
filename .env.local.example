# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Production URL — must match exactly, no trailing slash
# Local: http://localhost:3000  |  Production: https://wishsnipe.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Get from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IsThereAnyDeal — https://isthereanydeal.com/dev/app/
ITAD_API_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Random secret to protect the cron endpoint — generate with: openssl rand -base64 32
# Also add this as a GitHub repository secret (Settings → Secrets → Actions → CRON_SECRET)
# for the 6-hour GitHub Actions scheduler in .github/workflows/price-check.yml
CRON_SECRET=
